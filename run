#!/bin/bash

EXEC=""
TARGET="buildScript"
declare -A PARAMS
declare -i INDEX=0

for e in $@; do
  TARGET="$TARGET/$e"
  PARAMS[$INDEX]=$e
  INDEX=$INDEX+1
  shift
  # Prefer executable; fall back to any existing .sh (API pushes often drop +x)
  if [ -x "${TARGET}.sh" ] || [ -f "${TARGET}.sh" ]; then
    EXEC="${TARGET}.sh"
    PARAMS=()
    INDEX=0
  fi
done

echo ">> $EXEC"
if [ -x "$EXEC" ]; then
  exec "$EXEC" $PARAMS
else
  exec bash "$EXEC" $PARAMS
fi
